# FHIR n8n Custom Nodes - Production Environment Configuration
# Copy this file to .env and customize the values

# PostgreSQL Database Configuration
POSTGRES_USER=n8n
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=n8n

# n8n Security Configuration
N8N_ENCRYPTION_KEY=your-encryption-key-here-32-chars-minimum
N8N_USER_MANAGEMENT_JWT_SECRET=your-jwt-secret-here-32-chars-minimum

# Ollama LLM Configuration (optional)
OLLAMA_HOST=ollama:11434

# Example secure values (CHANGE THESE):
# POSTGRES_PASSWORD=fhir-n8n-secure-2025!
# N8N_ENCRYPTION_KEY=8f7a6e5d4c3b2a1f8e7d6c5b4a39485726394857
# N8N_USER_MANAGEMENT_JWT_SECRET=9g8h7i6j5k4l3m2n1o0p9q8r7s6t5u4v3w2x1y0z