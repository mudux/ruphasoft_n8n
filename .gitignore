# =======================
# Keep Important Files
# =======================
# These should be committed:
!.env.example
!.gitkeep
!README.md
!LICENSE
!CHANGELOG.md
!docker-compose-production.yml
!docker-compose-typescript.yml
!package.json
!tsconfig.json

# =======================
# Project Specific
# =======================

# Keep verification scripts
!verify-typescript-migration.js
!test-fhir-transformation.js
!deploy-production.sh

# Keep documentation
!*.md
!PRODUCTION_DEPLOYMENT_GUIDE.md
!TYPESCRIPT_MIGRATION_COMPLETE.md
!MIGRATION_SUCCESS_SUMMARY.md

# Keep TypeScript source
!nodes/
!src/
nodes/**/*.js
src/**/*.js

# Allow essential JavaScript utility files
!src/utils/semanticPaths.js
!src/utils/transformationPresets.js
!src/utils/fhirTransform.js
!src/mapping/autoDetector.js
!src/mapping/manualOverride.js
!src/mapping/patterns.js
!src/validation/forgivingValidator.js

# Keep essential config files
!tsconfig.json
!package.json
!docker-compose*.yml

# Ignore old/archived implementations
archived/

# =======================
# Security
# =======================
.secrets
.credentials
*.secrets
auth.json
private-keys/