{
  "name": "@fhir-n8n/patient",
  "version": "0.1.0",
  "description": "FHIR Patient resource node for n8n",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "nodes/**/*",
    "credentials/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fhir-n8n/core": "workspace:*",
    "@solarahealth/fhir-r4": "^2.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "jest": "^29.5.0",
    "n8n-workflow": "^1.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.0.0"
  },
  "keywords": [
    "n8n",
    "fhir",
    "patient",
    "healthcare",
    "custom-node"
  ],
  "author": "FHIR n8n Custom Nodes Team",
  "license": "MIT",
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/Patient/Patient.node.js"
    ]
  }
}