{
  "name": "fhir-n8n-custom-nodes",
  "version": "1.0.0",
  "description": "FHIR transformation nodes for n8n with intelligent auto-detection and manual override capabilities",
  "main": "nodes/index.js",
  "files": [
    "nodes/**/*",
    "src/**/*",
    "package.json",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "nodes/patient.js",
      "nodes/appointment.js",
      "nodes/bundle.js",
      "nodes/claimResponse.js",
      "nodes/eligibilityResponse.js"
    ]
  },
  "scripts": {
    "test-core": "node test_core.js",
    "test": "npm run test-core",
    "docker-setup": "node docker_setup.js",
    "docker-verify": "node docker_setup.js verify",
    "build": "echo 'Docker-only implementation - no build needed'"
  },
  "dependencies": {
    "n8n-workflow": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "fhir",
    "healthcare",
    "transformation",
    "auto-detection",
    "mapping"
  ],
  "author": "FHIR n8n Team",
  "license": "MIT"
}