{
  "name": "fhir-n8n-custom-nodes",
  "version": "1.0.0",
  "description": "FHIR transformation nodes for n8n with intelligent auto-detection and manual override capabilities",
  "main": "nodes/index.js",
  "files": [
    "dist/**/*",
    "nodes/**/*",
    "src/**/*",
    "package.json",
    "README.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": [
      "dist/nodes/FhirPatient/FhirPatient.node.js",
      "dist/nodes/FhirAppointment/FhirAppointment.node.js",
      "dist/nodes/FhirBundle/FhirBundle.node.js",
      "dist/nodes/FhirClaimResponse/FhirClaimResponse.node.js",
      "dist/nodes/FhirEligibilityResponse/FhirEligibilityResponse.node.js"
    ]
  },
  "scripts": {
    "test-core": "node test_core.js",
    "test": "npm run test-core",
    "docker-setup": "node docker_setup.js",
    "docker-verify": "node docker_setup.js verify",
    "build": "tsc",
    "dev": "n8n-node dev",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "n8n-workflow": "^1.120.1"
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.17.0",
    "@types/node": "^18.19.130",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "fhir",
    "healthcare",
    "transformation",
    "auto-detection",
    "mapping"
  ],
  "author": "FHIR n8n Team",
  "license": "MIT"
}
